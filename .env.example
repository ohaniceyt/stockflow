# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use the Supabase anon/public JWT key here (found in Supabase Dashboard > Project Settings > API).
VITE_SUPABASE_ANON_KEY=eyJhbG...

# Optional: local Supabase
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=your-local-anon-key

# Resend (server-side only, used in Supabase Edge Functions)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=StockFlow <team@updates.stockflow.grandigix.com>
# PUBLIC_APP_URL=https://stockflow.grandigix.com

# Optional: shared secrets for cron / auto-reminders (server-side only)
# CRON_SECRET=...
# AUTO_REMINDER_SECRET=...
# LOG_LEVEL=info

# Optional: Sentry public DSN (browser-side, safe to expose)
# VITE_SENTRY_DSN=https://public@ingest.sentry.io/project-id

# Optional: E2E real-backend teardown (only required to clean a real test org)
# E2E_SUPABASE_URL=https://your-project.supabase.co
# E2E_SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# Optional: production smoke-test scripts (do not commit real values)
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_ANON_KEY=eyJhbG...
# PUBLIC_APP_URL=https://stockflow.grandigix.com
# SMOKE_EMAIL=smoke@example.com
# SMOKE_PASSWORD=...

# Optional: initialize-session / check-admin scripts (do not commit real credentials)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbG...
# PLATFORM_ADMIN_EMAIL=admin@example.com
# PLATFORM_ADMIN_PASSWORD=...
